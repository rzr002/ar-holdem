# Optional API opponent configuration. Set these only when explicitly choosing API mode.
# Compatible endpoint: base URL is joined with /chat/completions (for example, https://provider.example/v1).
# OpenAI Chat Completions request fields: model, messages, response_format.
# Reference: https://developers.openai.com/api/reference/resources/chat/subresources/completions/methods/create
# No provider or model is selected by default; API usage may incur charges.
HOLDEM_API_BASE_URL=https://provider.example/v1
HOLDEM_API_MODEL=your-explicit-model-id
HOLDEM_API_KEY=replace-with-your-own-key
